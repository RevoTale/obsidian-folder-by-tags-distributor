{
	"name": "obsidian-folder-by-tags-distributor",
	"version": "1.0.21",
	"description": "Automatically move Obsidian notes into existing folders by tags specified in note.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "./node_modules/@typescript/native/bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": {
		"url": "https://revotale.com",
		"name": "Literally You",
		"email": "rusted@revotale.com"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/node": "^24.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	},
	"dependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
